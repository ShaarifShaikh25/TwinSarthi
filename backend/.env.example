# =====================================================================
# POLAR-TWIN Backend Configuration (.env.example)
# CAUTION: Never commit actual .env files, passwords, or JWT secrets to Git!
# Copy this file to .env and configure values for your environment.
# =====================================================================

# ---------------------------------------------------------------------
# Application Environment
# Options: development, staging, production
# ---------------------------------------------------------------------
ENVIRONMENT=development

# ---------------------------------------------------------------------
# Database Connection
# Standard PostgreSQL:
DATABASE_URL=postgresql://polar_user:polar_password@localhost:5432/polar_twin
# If using Docker compose networking:
# DATABASE_URL=postgresql://polar_user:polar_password@postgres:5432/polar_twin
# If using TimescaleDB enabled PostgreSQL:
# DATABASE_URL=postgresql://polar_user:polar_password@localhost:5432/polar_twin
# Local SQLite development / testing fallback:
# DATABASE_URL=sqlite:///./test.db
# ---------------------------------------------------------------------

# ---------------------------------------------------------------------
# JWT Authentication & Security
# Generate a cryptographically secure key: openssl rand -hex 32
# ---------------------------------------------------------------------
JWT_SECRET_KEY=change-this-to-a-secure-random-secret-in-production
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# ---------------------------------------------------------------------
# MQTT Broker Settings (Mosquitto)
# ---------------------------------------------------------------------
MQTT_BROKER=localhost
# If using Docker compose networking:
# MQTT_BROKER=mqtt
MQTT_PORT=1883
MQTT_USERNAME=
MQTT_PASSWORD=

# ---------------------------------------------------------------------
# Rule-Based Alert Engine Centralized Thresholds
# All thresholds can be tuned per Antarctic environmental policy.
# ---------------------------------------------------------------------
# Fuel level percentage below which CRITICAL alert is triggered
ALERT_FUEL_CRITICAL_THRESHOLD=20.0

# Fuel level percentage below which emergency CRITICAL alert is triggered
ALERT_FUEL_EMERGENCY_THRESHOLD=10.0

# Temperature in °C below which cold WARNING alert is triggered
ALERT_TEMP_SAFE_MIN_THRESHOLD=-50.0

# Wind speed in m/s above which CRITICAL blizzard alert is triggered
ALERT_WIND_MAX_THRESHOLD=40.0

# Generator electrical load percentage above which overload WARNING alert is triggered
ALERT_GENERATOR_LOAD_MAX_THRESHOLD=95.0
